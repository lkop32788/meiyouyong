<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Fixed test-only key: .env is gitignored, and statefulApi() puts
             EncryptCookies in front of every /api/* route, so without a key the
             whole suite dies on a clean checkout. -->
        <env name="APP_KEY" value="base64:tPBBb8Lxs0dPT4L8iYyf4hVNyTPzB2mGPd5IJHiQfXA=" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- MySQL, not sqlite. The app is MySQL-only in practice: analytics and
             audience queries use DAYOFWEEK / TIMESTAMPDIFF / JSON_CONTAINS,
             none of which sqlite has. Running the suite on sqlite meant three
             separate dialect bugs (DATEPART, GETUTCDATE, OPENJSON) shipped
             undetected — it gave confidence without coverage.

             Requires a dedicated test schema; see .env.example. RefreshDatabase
             truncates whatever DB_DATABASE points at, so this MUST NOT be the
             application database. -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="omnichannel_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- Separate message store too: MessagePersistenceService writes to
             MongoDB, and RefreshDatabase does not manage it. Tests that touch
             it use the RefreshesMongo trait to clear between cases. -->
        <env name="MONGODB_DATABASE" value="omnichannel_messages_test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
