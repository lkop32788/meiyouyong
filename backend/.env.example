APP_NAME="OmniClick"
# Deployment checklist: APP_ENV=production and APP_DEBUG=false before going
# live. With debug on, any unhandled exception returns a full stack trace plus
# the resolved config — which includes the companies table's encrypted AI keys
# and every connection string. The production host ran with local/true for
# months before this was noticed.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL / MariaDB — Primary Database
# Analytics queries use MySQL syntax (DAYOFWEEK / HOUR / TIMESTAMPDIFF) —
# pointing this at another engine will break AnalyticsController.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omnichannel
DB_USERNAME=omniclick
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# MongoDB — Message Storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=omnichannel_messages

# Session, Cache, Queue
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Laravel queue = Redis. NOT rabbitmq: config/queue.php has no such connection
# (the community driver does not support Laravel 13 — see ConsumeRabbitMQ), so
# QUEUE_CONNECTION=rabbitmq made every dispatch throw
# "The [rabbitmq] queue connection has not been configured".
#
# RabbitMQ is still the gateway→backend inbound transport; that path is the
# hand-rolled `php artisan rabbitmq:consume` consumer and has nothing to do
# with Laravel's queue.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Keep queued jobs off DB 0, which also holds presence hashes and the outbound
# rate-limit sorted sets — separate DBs make them independently inspectable.
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_DB=2

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Internal API Security
INTERNAL_API_KEY=generate-random-256-bit-hex

# Channel Credential Encryption (must be exactly 32 chars)
CREDENTIAL_ENCRYPTION_KEY=generate-32-char-key-here-xxxxxxx

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@omniclick.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Facebook Messenger (Page connect via OAuth) ──────────────────────────────
# Meta App credentials from developers.facebook.com → Your App → Settings → Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: Embedded Login config ID (for FB.login with config_id flow)
FACEBOOK_CONFIG_ID=
